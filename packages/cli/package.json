{
  "name": "@orbit/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The `orbit` CLI for scaffolding, validating, and packaging Orbit extensions.",
  "type": "module",
  "bin": {
    "orbit": "./dist/bin/orbit.js"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@orbit/api": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
